{
  "name": "@jugstalt/leaflet-gl-vectortiles",
  "version": "0.3.0",
  "description": "Leaflet layer for Mapbox Vector Tiles with GL styles: classic WebMercator vector tiles (basemap.at, OpenMapTiles, ESRI) and vector tiles in any projection and grid (gView GIS). One file, no dependencies, rendering in a web worker.",
  "main": "leaflet-gl-vectortiles.js",
  "unpkg": "leaflet-gl-vectortiles.min.js",
  "jsdelivr": "leaflet-gl-vectortiles.min.js",
  "files": [
    "leaflet-gl-vectortiles.js",
    "leaflet-gl-vectortiles.min.js",
    "leaflet-gl-vectortiles.min.js.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "terser leaflet-gl-vectortiles.js --compress --mangle --comments \"/^!/\" --source-map \"url='leaflet-gl-vectortiles.min.js.map'\" --output leaflet-gl-vectortiles.min.js",
    "test": "npm run build && node --test \"test/*.test.cjs\"",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "leaflet",
    "leaflet-plugin",
    "vector-tiles",
    "mvt",
    "mapbox-vector-tiles",
    "gl-style",
    "maplibre-style",
    "proj4leaflet",
    "gview"
  ],
  "peerDependencies": {
    "leaflet": "^1.9.0"
  },
  "devDependencies": {
    "terser": "^5.51.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jugstalt/leaflet-gl-vectortiles.git"
  },
  "bugs": {
    "url": "https://github.com/jugstalt/leaflet-gl-vectortiles/issues"
  },
  "homepage": "https://jugstalt.github.io/leaflet-gl-vectortiles/examples/",
  "license": "Apache-2.0"
}
